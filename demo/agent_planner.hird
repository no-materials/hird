// The v0.1 supervised agent planner demo.
//
// A Planner actor reads repository state through Tool<ReadRepo>, analyzes
// it (pure computation), files tickets through Tool<CreateTicket>, and
// logs progress through Tool<Log>. PlannerSup supervises it one_for_one:
// main starts the tree with `supervise` and reaches the running child
// with `child`, so the planner it drives is a supervised process.
// Every tool call is visible in the effect rows, resolvable through the
// runtime registry (the install block in main), and recorded on the audit
// stream — run `hird run demo/agent_planner.hird` and read stdout.

module AgentPlanner

// ── domain types ─────────────────────────────────────────────────

type Path = Path(String)
type TicketId = TicketId(String)

// A pending work item discovered in the repository: priority, title, body.
type Task = Task(Int, String, String)

// A cons list of tasks (v0.1 has no list patterns, so the demo carries
// its own).
type Backlog = Backlog(Task, Backlog) | EmptyBacklog

// What Tool<ReadRepo> reports: the branch name and the raw backlog.
type RepoState = RepoState(String, Backlog)

type PlannerConfig = PlannerConfig(String)
type PlannerState = PlannerState(Int, Int)
type PlannerStatus = PlannerStatus(Int, Int)

// ── tools ────────────────────────────────────────────────────────

tool ReadRepo : { path: Path } → RepoState
tool CreateTicket : { title: String, body: String } → TicketId
tool Log : { level: String, message: String } → ()

// ── pure analysis ────────────────────────────────────────────────

// The backlog restricted to actionable tasks (positive priority).
fn actionable(backlog: Backlog) → Backlog =
  match backlog {
    EmptyBacklog → EmptyBacklog,
    Backlog(Task(priority, title, body), rest) →
      if priority > 0
        then Backlog(Task(priority, title, body), actionable(rest))
        else actionable(rest),
  }

// Repository state to the tickets worth filing.
fn analyze(repo: RepoState) → Backlog =
  let RepoState(_, backlog) = repo in actionable(backlog)

// Files one ticket per task, logging each, and counts what it filed.
fn file_tickets(backlog: Backlog) → Int ! {Tool<CreateTicket>, Tool<Log>} =
  match backlog {
    EmptyBacklog → 0,
    Backlog(Task(_, title, body), rest) →
      let _ = create_ticket({ title: title, body: body }) in
      log({ level: "info", message: title });
      1 + file_tickets(rest),
  }

// ── the planner actor ────────────────────────────────────────────

actor Planner {
  state: PlannerState,

  message: PlannerMsg =
    | PlanRepo(Path)
    | GetStatus(ReplyTo<PlannerStatus>)
    | Shutdown,

  init: fn(config: PlannerConfig) ! {} = PlannerState(0, 0),

  handle PlanRepo(path), PlannerState(repos, tickets)
    ! {Tool<ReadRepo>, Tool<CreateTicket>, Tool<Log>} =
    log({ level: "info", message: "planning repository" });
    let repo = read_repo({ path: path }) in
    let filed = file_tickets(analyze(repo)) in
    log({ level: "info", message: "planning complete" });
    Continue(PlannerState(repos + 1, tickets + filed)),

  handle GetStatus(reply_to), PlannerState(repos, tickets)
    ! {Send<PlannerStatus>} =
    reply(reply_to, PlannerStatus(repos, tickets));
    Continue(PlannerState(repos, tickets)),

  // A deliberate stop, not a crash: the planner is a transient child, so
  // the supervisor leaves it stopped.
  handle Shutdown, _ ! {} = Stop,
} ! {Tool<ReadRepo>, Tool<CreateTicket>, Tool<Log>, Send<PlannerStatus>}

fn default_config() → PlannerConfig = PlannerConfig("planner")

// ── supervision ──────────────────────────────────────────────────

supervisor PlannerSup {
  strategy: one_for_one,
  intensity: 5,
  period: 60,
  children: [
    { id: planner, actor: Planner, start_args: default_config(), restart: transient },
  ]
}

// ── demo handlers (registry defaults) ────────────────────────────

// Canned repository state: two actionable tasks, one not worth filing.
fn demo_read_repo(args: { path: Path }) → RepoState =
  RepoState(
    "main",
    Backlog(Task(2, "Fix the lexer TODO", "The lexer carries a stale TODO comment."),
    Backlog(Task(0, "Tidy whitespace", "Cosmetic only; not worth a ticket."),
    Backlog(Task(1, "Fuzz the parser", "The parser has no fuzz harness."),
    EmptyBacklog))))

// "Creates" a ticket by echoing its title back as the id; the audit
// stream is the durable record.
fn demo_create_ticket(args: { title: String, body: String }) → TicketId =
  TicketId(args.title)

fn demo_log(args: { level: String, message: String }) → () = ()

// ── entry point ──────────────────────────────────────────────────

// Drives one planning round against the supervised planner: start the
// tree, look up the child, plan a repository, confirm tickets were
// filed, then ask the planner to stop itself.
fn run_demo() → () ! {Supervise, Send<PlannerMsg>, Await<PlannerStatus>} =
  supervise(PlannerSup);
  let planner = child(PlannerSup, planner) in
  send(planner, PlanRepo(Path("forest-rs/hird")));
  let PlannerStatus(_, tickets) = request(planner, GetStatus) in
  send(planner, Shutdown);
  if tickets > 0 then () else crash!("the planner filed no tickets")

// Handler maps never cross the supervision boundary: the install block
// is what the supervised planner's tool calls resolve through.
fn main() → () ! {Install, Supervise, Send<PlannerMsg>, Await<PlannerStatus>} =
  install {
    Tool<ReadRepo> → demo_read_repo,
    Tool<CreateTicket> → demo_create_ticket,
    Tool<Log> → demo_log,
  } in run_demo()
