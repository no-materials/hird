// A minimal supervised counter.
//
// Counter holds a single Int, bumps it on Increment, and answers GetCount
// over a typed reply channel. CounterSup supervises it one_for_one; main
// starts the tree, reaches the running child with `child`, and drives one
// round. No tools, so the only effects are message passing.

module CounterDemo

// ── domain types ─────────────────────────────────────────────────

type CounterConfig = CounterConfig(Int)
type alias CounterState = { count: Int }

// ── the counter actor ────────────────────────────────────────────

actor Counter {
  state: CounterState,

  message: CounterMsg =
    | Increment(Int)
    | GetCount(ReplyTo<Int>),

  init: fn(config: CounterConfig) ! {} =
    let CounterConfig(start) = config in { count: start },

  handle Increment(by), st ! {} =
    Continue({ count: st.count + by, ..st }),

  handle GetCount(reply_to), st ! {Send<Int>} =
    reply(reply_to, st.count);
    Continue(st),
} ! {Send<Int>}

// Counters start at zero.
fn initial_config() → CounterConfig = CounterConfig(0)

// ── supervision ──────────────────────────────────────────────────

supervisor CounterSup {
  strategy: one_for_one,
  intensity: 5,
  period: 60,
  children: [
    { id: counter, actor: Counter, start_args: initial_config(), restart: permanent },
  ]
}

// ── entry point ──────────────────────────────────────────────────

// Two increments against the supervised counter, then confirm the total.
fn main() → () ! {Supervise, Send<CounterMsg>, Await<Int>} =
  supervise(CounterSup);
  let counter = child(CounterSup, counter) in
  send(counter, Increment(2));
  send(counter, Increment(3));
  let total = request(counter, GetCount) in
  if total == 5 then () else crash!("the counter lost an increment")
