%% Generated from src/clock.hird by the Hirð compiler. Do not edit.
%% src/clock.hird:3
-module(hird_ticker).
-behaviour(gen_server).
-export([start_link/1]).
-export([init/1, handle_call/3, handle_cast/2]).

start_link(S) ->
    gen_server:start_link(?MODULE, S, []).

init(S) ->
    {ok, S}.

handle_call(Request, _From, _State) ->
    erlang:error({unexpected_call, Request}).

handle_cast(tick, State@1 = {st, N}) ->
    hird_actor:outcome({continue, {st, hird_clock:bump(N)}}, State@1);
handle_cast(via, State@1 = {st, N}) ->
    hird_actor:outcome(begin
        F = fun hird_clock:bump/1,
        {continue, {st, F(N)}}
    end, State@1).
