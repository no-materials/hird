-module(hird_pair).
-behaviour(gen_server).
-export([start_link/2]).
-export([init/1, handle_call/3, handle_cast/2]).

start_link(A, B) ->
    gen_server:start_link(?MODULE, {A, B}, []).

init({A, B}) ->
    {ok, {st, A + B}}.

handle_call(Request, _From, _State) ->
    erlang:error({unexpected_call, Request}).

handle_cast(nop, State@1 = {st, N}) ->
    hird_actor:outcome({continue, {st, N}}, State@1).
