%%%% hird_duo.erl
%% Generated from src/duo.hird by the Hirð compiler. Do not edit.
-module(hird_duo).
-export([boot/1, hird_tools@/0]).

%% src/duo.hird:8
boot(_Handlers@) ->
    Process@2 = hird_process:spawned(<<"Pair"/utf8>>),
    {ok, Pid@1} = hird_pair:start_link(Process@2, 1, 2),
    Pid@1.

hird_tools@() ->
    #{tools => #{},
        types => #{
            msg => [{nop, <<"Nop"/utf8>>, []}],
            st => [{st, <<"St"/utf8>>, [int]}]}}.

%%%% hird_pair.erl
%% Generated from src/duo.hird by the Hirð compiler. Do not edit.
%% src/duo.hird:2
-module(hird_pair).
-behaviour(gen_server).
-export([start_link/3]).
-export([init/1, handle_call/3, handle_cast/2]).

start_link(Process@1, A, B) ->
    gen_server:start_link(?MODULE, {Process@1, {A, B}}, []).

init({Process@1, {A, B}}) ->
    ok = hird_process:name(Process@1),
    {ok, {st, A + B}}.

handle_call(Request, _From, _State) ->
    erlang:error({unexpected_call, Request}).

handle_cast(nop, State@1 = {st, N}) ->
    hird_actor:outcome({continue, {st, N}}, State@1).
