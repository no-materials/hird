-module(hird_counter).
-behaviour(gen_server).
-export([start_link/1]).
-export([init/1, handle_call/3, handle_cast/2]).

start_link(S) ->
    gen_server:start_link(?MODULE, S, []).

init(S) ->
    {ok, S}.

handle_call(get, R, State@1 = {st, N}) ->
    hird_actor:outcome(begin
        _Sent = gen_server:reply(R, {status, N}),
        {continue, {st, N}}
    end, State@1).

handle_cast(inc, State@1 = {st, N}) ->
    hird_actor:outcome({continue, {st, N + 1}}, State@1).
