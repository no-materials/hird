source: crates/hird-check/tests/actors.rs
expression: "check_str(\"type Status = Status(Int)\\n\\\n         type Box<a> = BoxOf(a)\\n\\\n         type St = St(Int)\\n\\\n         actor A {\\n\\\n           state: St,\\n\\\n           message: Msg = | Ask(Box<ReplyTo<Status>>) | Stop,\\n\\\n           init: fn(s: St) -> St ! {} = s,\\n\\\n           handle Ask(b), st -> St ! {} = st,\\n\\\n           handle Stop, st -> St ! {} = st,\\n\\\n         }\")"
---
Ask : Box<ReplyTo<Status>> → Msg
BoxOf : ∀a. a → Box<a>
St : Int → St
Status : Int → Status
