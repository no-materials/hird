---
source: crates/hird-check/tests/actors.rs
expression: "check_str(\"type Cfg = Cfg(Clock, Int)\\n\\\n         type St = St(Clock, Int)\\n\\\n         actor Heart {\\n\\\n           state: St,\\n\\\n           message: HeartMsg = | Beat,\\n\\\n           init: fn(c: Cfg) ! {Schedule<HeartMsg>} =\\n\\\n             match c { Cfg(clock, period) ->\\n\\\n               let first = schedule(clock, self(), Beat, period) in St(clock, period) },\\n\\\n           handle Beat, St(clock, period) ! {Schedule<HeartMsg>} =\\n\\\n             let next = schedule(clock, self(), Beat, period) in Continue(St(clock, period)),\\n\\\n         } ! {Schedule<HeartMsg>}\\n\\\n         fn me() -> Pid<HeartMsg> = self()\")"
---
Beat : HeartMsg
Cfg : Clock → Int → Cfg
St : Clock → Int → St
me : () → Pid<HeartMsg>
error[C0055] 441..448: `self` can only be used inside an actor's `init` or handler body
