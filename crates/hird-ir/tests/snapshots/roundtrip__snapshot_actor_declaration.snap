source: crates/hird-ir/tests/roundtrip.rs
expression: pretty_print(&module)
---
module Actors

type Path = Path(String)

type St = St(Int)

tool ReadRepo : { path: Path } → St

actor Planner {
  state: St,
  message: PlannerMsg = Plan(Path) | Quit,
  init: fn(start: St) → St = start,
  handle Plan(p), st → Next<St> ! {Tool<ReadRepo>} = Continue(read_repo({ path: p })),
  handle Quit, st → Next<St> = Continue(st),
} ! {Tool<ReadRepo>}
